### 공통 변수 설정
@host = http://localhost:8080
@policyId = 1
@userId = 100

########################################################
# 1. 쿠폰 정책 생성 (WELCOME, 상대기간 30일, 전체상품 1,000원 할인)
########################################################
POST {{host}}/policy
Content-Type: application/json

{
  "policyName": "대박 이벤트 10퍼센트할인쿠폰",
  "policyType": "EVENT",
  "discountType": "RATE",
  "discountTargetType": "ALL",
  "discountValue": 10,

  "categoryId": null,
  "bookId": null,

  "validityType": "ABSOLUTE",
  "validDays": null,

  "startAt": "2025-11-11T00:00:00",
  "endAt": "2025-12-12T00:00:00",

  "limitedQuantity": 5000,

  "minOrderAmount": 0,
  "maxDiscountAmount": 25000,
  "isActivation": true
}

########################################################
# 2. 쿠폰 정책 전체 조회
########################################################
GET {{host}}/policy

########################################################
# 3. 쿠폰 정책 단건 조회
########################################################
GET {{host}}/policy/{{policyId}}

########################################################
# 4. 쿠폰 정책 수정 (이름만 바꿔보기 예시)
########################################################
PUT {{host}}/policy/{{policyId}}
Content-Type: application/json

{
  "policyName": "WELCOME 1000원 할인 - 수정본",
  "policyType": "WELCOME",
  "discountType": "PRICE",
  "discountTargetType": "ALL",
  "discountValue": 1000,

  "categoryId": null,
  "bookId": null,

  "validityType": "RELATIVE",
  "validDays": 60,

  "startAt": null,
  "endAt": null,

  "limitedQuantity": 2000,
  "minOrderAmount": 0,
  "maxDiscountAmount": 0,
  "isActivation": true
}

########################################################
# 5. 쿠폰 정책 비활성화 (삭제 대신 활성화 플래그 off)
########################################################
DELETE {{host}}/policy/{{policyId}}

########################################################
# 6. 일반 선착순 쿠폰 발급
#  - Redis에 미리 재고 셋업되어 있어야 함
#    > key: coupon:policy:{policyId}:stock
#    > 예: coupon:policy:1:stock = 100
########################################################
POST {{host}}/{{policyId}}/issue?userId={{userId}}

########################################################
# 7. 웰컴 쿠폰 발급 (WELCOME 정책을 찾아서 issue2로 MQ에 전송)
#  - CouponPolicy에 policyType=WELCOME 인 정책이 하나 있어야 함
########################################################
POST {{host}}/welcome?userId={{userId}}