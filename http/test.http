### base URL
@base_url = http://localhost:8080

###########################################
# STEP 1) 쿠폰 정책 생성 (EVENT - 절대기간)
###########################################

### 정책 생성 (Event / Absolute)
#POST {{base_url}}/policies
#Content-Type: application/json
#
#{
#  "policyName": "이벤트 10% 할인",
#  "policyType": "EVENT",
#  "discountType": "RATE",
#  "discountTargetType": "ALL",
#  "discountValue": 10,
#  "validityType": "ABSOLUTE",
#  "startDate": "2025-12-01T00:00:00",
#  "endDate": "2025-12-31T23:59:59",
#  "limitedQuantity": 5000,
#  "minOrderAmount": 0,
#  "maxDiscountAmount": 25000,
#  "isActivation": true
#}

### 정책 목록 조회 (정책 ID 확인용)
GET {{base_url}}/policies


###########################################
# STEP 2) 선착순 쿠폰 발급 테스트
###########################################

### (성공 예상) 선착순 발급 요청
POST {{base_url}}/policies/9/issue?userId=100

### Redis 재고 확인 (직접 redis-cli에서 실행해야 함)
# redis-cli -h s4.java21.net -p 6379 -a '비번'
# SELECT 380
# HGETALL coupon:policy:1


###########################################
# STEP 3) 중복 발급 방지 테스트
###########################################

### 빠르게 2번 연달아 실행 → 두 번째 요청은 409 또는 400 떠야 정상

### 1차 발급
POST {{base_url}}/policies/9/issue?userId=10

### 2차 중복 발급 (실패해야 정상)
POST {{base_url}}/policies/9/issue?userId=10


### Redis 잠금 키 확인 (redis-cli에서)
# GET coupon:dup:1:100
# TTL coupon:dup:1:100


###########################################
# STEP 4) 웰컴 쿠폰 발급 테스트
###########################################

### 웰컴 쿠폰 발급 요청 (재고 없음)
POST {{base_url}}/welcome?userId=300


###########################################
# STEP 5) DLQ 보상 로직 테스트
###########################################

# 방법:
# 1) 먼저 userId=200으로 성공 발급
# 2) 다시 userId=200으로 강제로 두 번 보내면 consumer 단계 Unique 제약으로 에러 발생
# 3) DLQ 이동 확인
# 4) DLQ consumer가 재고 복구하는지 확인

### 1차 정상 발급
POST {{base_url}}/policies/9/issue?userId=400

### 2차 → consumer에서 오류 발생 → DLQ로 빠져야 함
POST {{base_url}}/policies/9/issue?userId=400

### 메시지 확인 (RabbitMQ 웹에서)
# Queue: coupon4.issue.dlq

### Redis 재고 복구 확인 (redis-cli)
# HGET coupon:policy:1 stock

